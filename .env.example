# 仅供本地开发与 Compose 冒烟测试；生产环境必须替换全部 development-only 值。
COMPOSE_PROJECT_NAME=pnx-training
APP_IMAGE_TAG=dev
APP_ENV=development
APP_HTTP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai
TRUSTED_HOSTS=localhost,127.0.0.1,backend
CAMPUS_EMAIL_DOMAIN=connect.hkust-gz.edu.cn
LOG_LEVEL=INFO

SESSION_CURRENT_SECRET=development-only-session-secret-at-least-32-bytes
SESSION_PREVIOUS_SECRET=
CSRF_SECRET=development-only-csrf-secret-at-least-32-bytes
# 队伍邀请码 HMAC 独立 pepper；生产至少 32 字节且不得复用其他密钥。
TEAM_INVITE_CODE_PEPPER=development-only-team-invite-pepper-32-bytes
SESSION_COOKIE_SECURE=false
# URL-safe Base64 编码的 32 字节密钥；生产必须独立随机生成。
OUTBOX_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

POSTGRES_DB=pnx_training
POSTGRES_USER=pnx
POSTGRES_PASSWORD=development-only-postgres-password
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=4

MINIO_ROOT_USER=pnx_dev_access
MINIO_ROOT_PASSWORD=development-only-minio-secret-key
MINIO_BUCKET=pnx-training
MINIO_REGION=us-east-1
MINIO_PUBLIC_BASE_URL=http://localhost:8080/storage

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@connect.hkust-gz.edu.cn
MAIL_REPLY_TO=no-reply@connect.hkust-gz.edu.cn

GLOBAL_MAX_UPLOAD_BYTES=2147483648
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_SESSION_TTL_SECONDS=86400

WORKER_NAME=primary
WORKER_HEARTBEAT_INTERVAL_SECONDS=60
WORKER_STALE_AFTER_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LOCK_LEASE_SECONDS=300
