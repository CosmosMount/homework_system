# 生产环境非秘密模板。复制到宿主机受控目录并填写；所有 *_SOURCE 指向权限受限的单行 secret 文件。
COMPOSE_PROJECT_NAME=pnx-training-production
BACKEND_IMAGE=registry.example.edu/pnx-training-backend@sha256:replace-with-digest
FRONTEND_IMAGE=registry.example.edu/pnx-training-frontend@sha256:replace-with-digest
APP_BASE_URL=https://training-hub.internal.example.edu
TRUSTED_HOSTS=training-hub.internal.example.edu,backend
APP_TIMEZONE=Asia/Shanghai
CAMPUS_EMAIL_DOMAIN=connect.hkust-gz.edu.cn
LOG_LEVEL=INFO
MINIO_PUBLIC_BASE_URL=https://training-hub.internal.example.edu/storage
SESSION_COOKIE_SECURE=true

PRODUCTION_HTTP_BIND=0.0.0.0
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_BIND=0.0.0.0
PRODUCTION_HTTPS_PORT=443
TLS_CERTIFICATE_SOURCE=/srv/pnx-training-hub/nginx/certs/fullchain.pem
TLS_PRIVATE_KEY_SOURCE=/srv/pnx-training-hub/nginx/certs/privkey.pem

SESSION_CURRENT_SECRET_SOURCE=/srv/pnx-training-hub/env/secrets/session_current_secret
CSRF_SECRET_SOURCE=/srv/pnx-training-hub/env/secrets/csrf_secret
TEAM_INVITE_CODE_PEPPER_SOURCE=/srv/pnx-training-hub/env/secrets/team_invite_code_pepper
OUTBOX_ENCRYPTION_KEY_SOURCE=/srv/pnx-training-hub/env/secrets/outbox_encryption_key

POSTGRES_DB=pnx_training
POSTGRES_USER=pnx
DATABASE_PASSWORD_SOURCE=/srv/pnx-training-hub/env/secrets/database_password
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=4

MINIO_ACCESS_KEY_SOURCE=/srv/pnx-training-hub/env/secrets/minio_access_key
MINIO_SECRET_KEY_SOURCE=/srv/pnx-training-hub/env/secrets/minio_secret_key
MINIO_BUCKET=pnx-training
MINIO_REGION=us-east-1

SMTP_HOST=smtp.internal.example.edu
SMTP_PORT=587
SMTP_USERNAME=pnx-training
SMTP_PASSWORD_SOURCE=/srv/pnx-training-hub/env/secrets/smtp_password
SMTP_STARTTLS=true
MAIL_FROM=no-reply@connect.hkust-gz.edu.cn
MAIL_REPLY_TO=no-reply@connect.hkust-gz.edu.cn

GLOBAL_MAX_UPLOAD_BYTES=2147483648
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_SESSION_TTL_SECONDS=86400
WORKER_NAME=primary
WORKER_HEARTBEAT_INTERVAL_SECONDS=60
WORKER_STALE_AFTER_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LOCK_LEASE_SECONDS=300

# 宿主机备份工具的非秘密路径；backup-state 必须为本机 0700 目录，且不得位于 backups 内。
BACKUP_OUTPUT_DIR=/srv/pnx-training-hub/backups
BACKUP_STATE_DIR=/srv/pnx-training-hub/state/backup
BACKUP_WORK_ROOT=/srv/pnx-training-hub/tmp
BACKUP_GPG_RECIPIENT=replace-with-40-to-64-character-fingerprint
NGINX_CONFIG_FILE=/srv/pnx-training-hub/nginx/nginx.production.conf
